APP_NAME=OrgSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "log" for local dev (emails land in storage/logs/laravel.log).
# For real delivery: "resend" (requires RESEND_API_KEY from resend.com — free
# tier can only send to your own Resend account email until a domain is
# verified) or "smtp" via Gmail (requires a Google Account App Password, not
# your real password: myaccount.google.com/apppasswords — needs 2-Step
# Verification enabled first). IMPORTANT for Gmail/STARTTLS on port 587: set
# MAIL_SCHEME=smtp explicitly — leaving it null/blank makes Symfony Mailer
# attempt implicit TLS on a STARTTLS-only port, which just hangs until
# timeout instead of failing fast.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Register a Web-platform app at portal.azure.com with a single fixed
# redirect URI (this app's APP_URL + /microsoft/callback) and delegated
# scopes Files.ReadWrite, offline_access, User.Read, openid, profile, email.
# Leave blank to keep "Open in Word/Excel/PowerPoint" as a plain download.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Path to the LibreOffice soffice binary, used to convert DOCX/XLS/PPTX to
# PDF for in-app preview. Leave blank to use this OS's default guess.
LIBREOFFICE_BINARY=
LIBREOFFICE_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
